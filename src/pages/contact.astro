---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import DiscordInvite from '../components/DiscordInvite.astro';
---

<BaseLayout title="Contact">
  <h1>Let's Create Change Together</h1>
  <h2>Send Us a Message</h2>
  <p>
    Simply pop your details into the form and we'll reply as soon as we can! Whether you want to
    join the neighborhood group, have ideas you want to share, or are just looking to connect with
    neighbors, we'd love to hear from you!
  </p>

  <form
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="flex flex-col gap-2 max-w-lg"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="hidden">
      <label>Don't fill this out if you're human: <input name="bot-field" /></label>
    </p>

    <label for="name" class="font-bold text-teal-dark mt-2">Name</label>
    <input id="name" name="name" type="text" required class="input" />

    <label for="email" class="font-bold text-teal-dark mt-2">Email</label>
    <input id="email" name="email" type="email" required class="input" />

    <label for="message" class="font-bold text-teal-dark mt-2">Message</label>
    <textarea id="message" name="message" rows="6" required class="input"></textarea>

    <button type="submit" class="btn mt-4 self-start">Send</button>
  </form>

  <div class="flex flex-col gap-5 mt-10">
    <NewsletterSignup />
    <DiscordInvite />
  </div>
</BaseLayout>
