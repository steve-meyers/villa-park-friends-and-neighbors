---
export const prerender = false;

import { fetchUpcomingEvents, formatEventDate, eventSlug, type CalendarEvent } from '../../lib/calendar';

interface PickerEvent {
  id: string;
  title: string;
  dateLabel: string;
  description: string;
  link: string;
}

let upcomingEvents: PickerEvent[] = [];
let calendarError: string | null = null;

function toPickerEvent(event: CalendarEvent): PickerEvent {
  const datePart = formatEventDate(event, { weekday: 'short', month: 'short', day: 'numeric' });
  const timePart = event.allDay ? '' : ' · ' + formatEventDate(event, { hour: 'numeric', minute: '2-digit' });
  return {
    id: event.id,
    title: event.title,
    dateLabel: datePart + timePart,
    description: event.description,
    link: `https://villaparkfans.com/events/${eventSlug(event)}`,
  };
}

try {
  upcomingEvents = (await fetchUpcomingEvents(15)).map(toPickerEvent);
} catch (err) {
  calendarError = err instanceof Error ? err.message : 'Could not load events from the calendar.';
}

// Embedded as a JSON data-island for the client script. Event titles/descriptions
// come from an externally-editable Google Calendar, so `<` is escaped to < to
// guarantee no "</script>" sequence can break out of this script tag.
const upcomingEventsJson = JSON.stringify(upcomingEvents).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Newsletter Builder — Villa Park FANs</title>
  <style>
    :root {
      --teal: #3f7a76;
      --teal-dark: #24504c;
      --gold: #edd286;
      --ink: #3a2f10;
      --paper: #fffaf0;
      --line: #e9e0c8;
      --muted: #6b6552;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f4f1e8;
      color: #222;
    }
    header.app-header {
      background: var(--teal-dark);
      color: #fff;
      padding: 18px 24px;
    }
    header.app-header h1 { margin: 0 0 4px 0; font-size: 18px; letter-spacing: 0.3px; }
    header.app-header p { margin: 0; font-size: 13px; color: #cfe3e0; max-width: 900px; line-height: 1.5; }
    .howto {
      background: #fff;
      border-bottom: 1px solid #e2ddc9;
      padding: 14px 24px;
      font-size: 13px;
      line-height: 1.6;
      color: #444;
    }
    .howto ol { margin: 6px 0 0 18px; padding: 0; }
    .howto strong { color: #111; }
    .auth-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 24px;
      background: #fff8e0;
      border-bottom: 1px solid #e2ddc9;
      font-size: 13px;
    }
    .auth-bar button { font: inherit; font-weight: 700; cursor: pointer; border: 1px solid var(--line); background: var(--gold); padding: 6px 14px; border-radius: 6px; }
    .auth-gate { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--teal-dark); padding: 24px; }
    .auth-gate-box { background: #fff; border-radius: 10px; padding: 32px 36px; max-width: 380px; text-align: center; }
    .auth-gate-box h1 { font-size: 18px; margin: 0 0 12px 0; }
    .auth-gate-box p { color: var(--muted); font-size: 14px; line-height: 1.5; margin: 0 0 18px 0; }
    .auth-gate-box button { font: inherit; font-weight: 700; cursor: pointer; border: 1px solid var(--gold); background: var(--gold); padding: 10px 22px; border-radius: 6px; font-size: 14px; }
    .layout { display: flex; gap: 0; height: calc(100vh - 180px); }
    .form-pane { width: 44%; min-width: 380px; height: 100%; overflow-y: auto; padding: 20px 24px 80px 24px; background: #fbfaf5; border-right: 1px solid #e2ddc9; }
    .preview-pane { flex: 1; display: flex; flex-direction: column; height: 100%; min-width: 0; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 16px; background: #fff; border-bottom: 1px solid #e2ddc9; position: sticky; top: 0; }
    button { font: inherit; cursor: pointer; border: 1px solid var(--line); background: #fff; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; color: var(--ink); }
    button.primary { background: var(--gold); border-color: var(--gold); }
    button.subtle { background: transparent; color: var(--muted); font-weight: 500; }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    button:active { transform: translateY(1px); }
    .toast { font-size: 12px; color: #1b7a4d; font-weight: 600; align-self: center; opacity: 0; transition: opacity 0.15s; }
    .toast.show { opacity: 1; }
    iframe#previewFrame { flex: 1; width: 100%; border: 0; background: var(--paper); }
    .draft-controls { display: flex; gap: 8px; margin-bottom: 16px; }
    .draft-controls button { flex: 1; }
    fieldset { border: 1px solid var(--line); border-radius: 8px; margin: 0 0 16px 0; padding: 14px 14px 6px 14px; background: #fff; }
    legend { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--teal-dark); padding: 0 6px; }
    label { display: block; font-size: 12px; font-weight: 600; color: #333; margin: 10px 0 4px 0; }
    label.checkbox { display: flex; align-items: center; gap: 8px; font-weight: 700; }
    label .hint { display: block; font-weight: 400; color: var(--muted); font-size: 11px; margin-top: 2px; }
    p.hint { color: var(--muted); font-size: 11px; }
    input[type="text"], input[type="url"], textarea { width: 100%; font: inherit; font-size: 13px; padding: 8px 10px; border: 1px solid #d8d2bd; border-radius: 6px; background: #fffef9; }
    textarea { resize: vertical; min-height: 54px; }
    .news-item { border: 1px dashed var(--line); border-radius: 6px; padding: 10px 12px 4px 12px; margin-bottom: 12px; background: #fffdf6; }
    .news-item-head { display: flex; justify-content: space-between; align-items: center; }
    .news-item-head span { font-size: 12px; font-weight: 700; color: var(--teal-dark); }
    .remove-btn { border: none; background: none; color: #b3432b; font-size: 12px; font-weight: 600; padding: 2px 4px; }
    .add-btn { margin: 4px 0 16px 0; width: 100%; }
    .calendar-event-row { display: flex; align-items: baseline; gap: 8px; padding: 8px 4px; border-bottom: 1px dotted var(--line); font-size: 13px; }
    .calendar-event-row:last-child { border-bottom: none; }
    .save-row { display: flex; gap: 8px; align-items: flex-end; }
    .save-row > div { flex: 1; }
    @media (max-width: 900px) {
      .layout { flex-direction: column; height: auto; }
      .form-pane, .preview-pane { width: 100%; height: auto; max-height: none; }
      iframe#previewFrame { min-height: 600px; }
    }
  </style>
</head>
<body>

<div id="authGate" class="auth-gate">
  <div class="auth-gate-box">
    <h1>🏡 Villa Park FANs — Newsletter Builder</h1>
    <p id="gateStatus">Checking login status…</p>
    <button type="button" id="gateLoginBtn" class="primary" hidden>Log in</button>
  </div>
</div>

<div id="builderContent" hidden>

<header class="app-header">
  <h1>🏡 Villa Park FANs — Newsletter Builder</h1>
  <p>Fill in this month's content, pick events straight from the calendar, watch the preview update, then copy the HTML/plain text into MailerLite or save a copy to the repo.</p>
</header>

<div class="auth-bar">
  <span id="authNote">Checking login status…</span>
</div>

<div class="howto">
  <strong>How to send this month's newsletter:</strong>
  <ol>
    <li>Fill in the fields on the left. Check any calendar events to include, or add a custom one, and use Add/Remove for news items.</li>
    <li>In MailerLite, create a new campaign, then choose <strong>Custom HTML</strong> as the content type.</li>
    <li>Click <strong>Copy HTML for MailerLite</strong> below and paste it into MailerLite's HTML code editor (replace everything there).</li>
    <li>Click <strong>Copy Plain Text for MailerLite</strong> and paste it into the campaign's <strong>Plain text</strong> tab (it defaults to generic MailerLite boilerplate — replace it).</li>
    <li>Copy the <strong>Subject line</strong> field into MailerLite's subject field too.</li>
    <li>Optionally, click <strong>Save to repo</strong> to keep a permanent copy alongside the site's other content.</li>
  </ol>
  <p style="margin:10px 0 0 0; color:#555;">Your progress here also autosaves to this browser as you type (<span id="autosaveStatus">not saved yet</span>). Use <strong>Save draft to file</strong> to move work to another computer or hand it to someone else.</p>
</div>

<div class="layout">
  <div class="form-pane" id="formPane">

    <div class="draft-controls">
      <button type="button" id="saveDraftBtn">💾 Save draft to file</button>
      <button type="button" id="loadDraftBtn">📂 Load draft from file</button>
      <input type="file" id="loadDraftInput" accept="application/json" style="display:none;">
    </div>

    <fieldset>
      <legend>Campaign setup</legend>
      <label for="subject">Subject line
        <span class="hint">Shown in the recipient's inbox. Paste into MailerLite's subject field.</span>
      </label>
      <input type="text" id="subject">

      <label for="preheader">Preview text (preheader)
        <span class="hint">The snippet inboxes show next to the subject line.</span>
      </label>
      <input type="text" id="preheader">
    </fieldset>

    <fieldset>
      <legend>Intro</legend>
      <label for="title">Newsletter title</label>
      <input type="text" id="title">

      <label for="intro">Intro text
        <span class="hint">Keep <code>{"{$name|neighbor}"}</code> in the sentence — MailerLite replaces it with the subscriber's first name, or "neighbor" if it doesn't have one.</span>
      </label>
      <textarea id="intro" rows="3"></textarea>

      <label for="heroImageUrl">Hero image URL
        <span class="hint">Upload the photo in the site admin (/admin media library) first, then paste its URL here. Recommended size 1200×600.</span>
      </label>
      <input type="url" id="heroImageUrl">

      <label for="heroImageAlt">Hero image alt text</label>
      <input type="text" id="heroImageAlt">
    </fieldset>

    <fieldset>
      <legend>Events</legend>
      <label style="margin-top:0;">Upcoming events from your calendar</label>
      <div id="calendarEventsChecklist"><p class="hint">Loading…</p></div>
      <div id="eventsContainer"></div>
      <button type="button" class="add-btn" id="addCustomEvent">+ Add a custom event (not on the calendar)</button>
    </fieldset>

    <fieldset>
      <legend>Neighborhood news</legend>
      <div id="newsItemsContainer"></div>
      <button type="button" class="add-btn" id="addNewsItem">+ Add another news item</button>
    </fieldset>

    <fieldset>
      <legend>Call to action</legend>
      <label for="ctaHeading">Heading</label>
      <input type="text" id="ctaHeading">

      <label for="ctaBody">Body text</label>
      <textarea id="ctaBody" rows="2"></textarea>

      <label for="ctaButtonText">Button text</label>
      <input type="text" id="ctaButtonText">

      <label for="ctaLink">Button link</label>
      <input type="url" id="ctaLink">
    </fieldset>

    <fieldset>
      <legend>Footer</legend>
      <label for="footerTagline">Tagline</label>
      <input type="text" id="footerTagline">

      <label for="siteDisplay">Website (display text)</label>
      <input type="text" id="siteDisplay">

      <label for="siteUrl">Website (link)</label>
      <input type="url" id="siteUrl">

      <p class="hint" style="margin-top:14px;">Company name, mailing address, unsubscribe link, and "view in browser" link are filled in automatically by MailerLite — they're not editable here.</p>
    </fieldset>

    <fieldset>
      <legend>Save to repo</legend>
      <div class="save-row">
        <div>
          <label for="saveSlug" style="margin-top:0;">File name</label>
          <input type="text" id="saveSlug">
        </div>
        <button type="button" class="primary" id="saveRepoBtn" disabled>Save to repo</button>
      </div>
      <p class="hint">Saves a copy under email-templates/sent/ in the repo — for the record, not for publishing. It won't trigger a site deploy.</p>
    </fieldset>

    <button type="button" class="subtle" id="resetBtn">Reset all fields to example content</button>
  </div>

  <div class="preview-pane">
    <div class="toolbar">
      <button type="button" class="primary" id="copyHtmlBtn">Copy HTML for MailerLite</button>
      <button type="button" class="primary" id="copyTextBtn">Copy Plain Text for MailerLite</button>
      <button type="button" id="downloadHtmlBtn">Download .html</button>
      <button type="button" id="downloadTextBtn">Download .txt</button>
      <span class="toast" id="toast"></span>
    </div>
    <iframe id="previewFrame" title="Newsletter preview"></iframe>
  </div>
</div>

</div>

<script type="application/json" id="upcomingEventsData" set:html={upcomingEventsJson}></script>
<script type="application/json" id="calendarErrorData" set:html={JSON.stringify(calendarError)}></script>

<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

<script>
(function () {
  "use strict";

  var STORAGE_KEY = "vpfans-newsletter-builder-draft-v2";

  var upcomingEventsData = JSON.parse(document.getElementById("upcomingEventsData").textContent || "[]");
  var calendarError = JSON.parse(document.getElementById("calendarErrorData").textContent || "null");

  var defaultState = {
    subject: "This Month in Villa Park 🏡",
    preheader: "Your monthly roundup of Villa Park news, events, and neighbor updates.",
    title: "This Month in Villa Park",
    intro: "Hey {$name|neighbor}, here's what's happening around the neighborhood this month — news, upcoming events, and a few things worth knowing.",
    heroImageUrl: "https://villaparkfans.com/images/uploads/website-dug-1.jpeg",
    heroImageAlt: "Villa Park neighborhood",
    events: [],
    newsItems: [
      { imageUrl: "", headline: "", summary: "", link: "" }
    ],
    ctaHeading: "Get Involved",
    ctaBody: "Join a Circle, volunteer for an event, or just come say hi at the next meetup.",
    ctaButtonText: "Visit the Site",
    ctaLink: "https://villaparkfans.com",
    footerTagline: "Building community, taking action, and celebrating the Villa Park neighborhood.",
    siteDisplay: "villaparkfans.com",
    siteUrl: "https://villaparkfans.com"
  };

  var simpleFieldIds = [
    "subject", "preheader", "title", "intro", "heroImageUrl", "heroImageAlt",
    "ctaHeading", "ctaBody", "ctaButtonText", "ctaLink",
    "footerTagline", "siteDisplay", "siteUrl"
  ];

  function escapeHtml(str) {
    return String(str == null ? "" : str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function slugify(str) {
    return String(str || "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 60);
  }

  function defaultSlug(title) {
    var now = new Date();
    var ym = now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0");
    var titleSlug = slugify(title) || "newsletter";
    return ym + "-" + titleSlug;
  }

  var localStorageAvailable = (function () {
    try {
      var testKey = "__vpfans_storage_test__";
      localStorage.setItem(testKey, "1");
      localStorage.removeItem(testKey);
      return true;
    } catch (e) {
      return false;
    }
  })();

  function mergeWithDefaults(saved) {
    if (!saved || typeof saved !== "object") return JSON.parse(JSON.stringify(defaultState));
    var merged = JSON.parse(JSON.stringify(defaultState));
    for (var key in saved) {
      if (Object.prototype.hasOwnProperty.call(saved, key)) merged[key] = saved[key];
    }
    if (!Array.isArray(merged.newsItems)) merged.newsItems = [];
    if (!Array.isArray(merged.events)) merged.events = [];
    return merged;
  }

  function loadState() {
    var saved = null;
    if (localStorageAvailable) {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (raw) saved = JSON.parse(raw);
      } catch (e) { /* ignore corrupt storage */ }
    }
    return mergeWithDefaults(saved);
  }

  var state = loadState();

  function saveState() {
    var statusEl = document.getElementById("autosaveStatus");
    if (!localStorageAvailable) {
      if (statusEl) statusEl.textContent = "autosave isn't available in this browser — use “Save draft to file” instead";
      return;
    }
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      if (statusEl) statusEl.textContent = "last saved " + new Date().toLocaleTimeString();
    } catch (e) {
      if (statusEl) statusEl.textContent = "autosave failed — use “Save draft to file” instead";
    }
  }

  // ---- news items (identical pattern to events, kept separate for editing clarity) ----

  function newsItemTemplate(item, index) {
    var wrap = document.createElement("div");
    wrap.className = "news-item";
    wrap.dataset.index = index;
    wrap.innerHTML =
      '<div class="news-item-head"><span>News item ' + (index + 1) + '</span>' +
      '<button type="button" class="remove-btn" data-remove="' + index + '">Remove</button></div>' +
      '<label>Image URL</label><input type="url" data-field="imageUrl" value="' + escapeHtml(item.imageUrl) + '">' +
      '<label>Headline</label><input type="text" data-field="headline" value="' + escapeHtml(item.headline) + '">' +
      '<label>Summary</label><textarea rows="2" data-field="summary">' + escapeHtml(item.summary) + '</textarea>' +
      '<label>Link</label><input type="url" data-field="link" value="' + escapeHtml(item.link) + '">';
    return wrap;
  }

  function renderNewsItems() {
    var container = document.getElementById("newsItemsContainer");
    container.innerHTML = "";
    state.newsItems.forEach(function (item, i) {
      container.appendChild(newsItemTemplate(item, i));
    });
    container.querySelectorAll(".remove-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var idx = Number(btn.dataset.remove);
        state.newsItems.splice(idx, 1);
        renderNewsItems();
        onChange();
      });
    });
    container.querySelectorAll("input, textarea").forEach(function (el) {
      el.addEventListener("input", function () {
        var idx = Number(el.closest(".news-item").dataset.index);
        state.newsItems[idx][el.dataset.field] = el.value;
        onChange();
      });
    });
  }

  // ---- events: calendar checklist + editable event cards ----

  function renderCalendarChecklist() {
    var container = document.getElementById("calendarEventsChecklist");
    if (calendarError) {
      container.innerHTML = '<p class="hint">Could not load events from the calendar: ' + escapeHtml(calendarError) + '</p>';
      return;
    }
    if (!upcomingEventsData.length) {
      container.innerHTML = '<p class="hint">No upcoming events found on the calendar.</p>';
      return;
    }
    container.innerHTML = "";
    upcomingEventsData.forEach(function (ev) {
      var checked = state.events.some(function (e) { return e.calendarId === ev.id; });
      var row = document.createElement("label");
      row.className = "calendar-event-row";
      row.innerHTML =
        '<input type="checkbox" data-calendar-id="' + escapeHtml(ev.id) + '"' + (checked ? " checked" : "") + '>' +
        '<span><strong>' + escapeHtml(ev.title) + '</strong> — ' + escapeHtml(ev.dateLabel) + '</span>';
      container.appendChild(row);
    });
    container.querySelectorAll("input[type=checkbox]").forEach(function (cb) {
      cb.addEventListener("change", function () {
        var id = cb.dataset.calendarId;
        if (cb.checked) {
          var src = upcomingEventsData.filter(function (e) { return e.id === id; })[0];
          if (src) {
            state.events.push({
              calendarId: id,
              name: src.title,
              date: src.dateLabel,
              description: src.description || "",
              link: src.link
            });
          }
        } else {
          state.events = state.events.filter(function (e) { return e.calendarId !== id; });
        }
        renderEventCards();
        onChange();
      });
    });
  }

  function eventCardTemplate(item, index) {
    var wrap = document.createElement("div");
    wrap.className = "news-item";
    wrap.dataset.index = index;
    wrap.innerHTML =
      '<div class="news-item-head"><span>' + (item.calendarId ? "From calendar" : "Custom event") + '</span>' +
      '<button type="button" class="remove-btn" data-remove="' + index + '">Remove</button></div>' +
      '<label>Event name</label><input type="text" data-field="name" value="' + escapeHtml(item.name) + '">' +
      '<label>Date &amp; time</label><input type="text" data-field="date" value="' + escapeHtml(item.date) + '">' +
      '<label>Description</label><textarea rows="2" data-field="description">' + escapeHtml(item.description) + '</textarea>' +
      '<label>Link</label><input type="url" data-field="link" value="' + escapeHtml(item.link) + '">';
    return wrap;
  }

  function renderEventCards() {
    var container = document.getElementById("eventsContainer");
    container.innerHTML = "";
    state.events.forEach(function (item, i) {
      container.appendChild(eventCardTemplate(item, i));
    });
    container.querySelectorAll(".remove-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var idx = Number(btn.dataset.remove);
        var removed = state.events.splice(idx, 1)[0];
        renderEventCards();
        if (removed && removed.calendarId) renderCalendarChecklist();
        onChange();
      });
    });
    container.querySelectorAll("input, textarea").forEach(function (el) {
      el.addEventListener("input", function () {
        var idx = Number(el.closest(".news-item").dataset.index);
        state.events[idx][el.dataset.field] = el.value;
        onChange();
      });
    });
  }

  function populateSimpleFields() {
    simpleFieldIds.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.value = state[id] || "";
    });
    document.getElementById("saveSlug").value = defaultSlug(state.title);
  }

  function bindSimpleFields() {
    simpleFieldIds.forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener("input", function () {
        state[id] = el.value;
        onChange();
      });
    });
  }

  var EMAIL_HEAD_STYLE =
    "<style>" +
    "@import url('https://fonts.googleapis.com/css2?family=Grandstander:wght@700;800&family=Nunito:wght@400;600;700;800&display=swap');" +
    "body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }" +
    "table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }" +
    "img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }" +
    "body { margin: 0; padding: 0; width: 100% !important; height: 100% !important; }" +
    ".heading { font-family: 'Grandstander', 'Trebuchet MS', Verdana, sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #4c8783; }" +
    ".body-text { font-family: 'Nunito', Verdana, Arial, sans-serif; color: #3a2f10; }" +
    "a.btn-link { color: #3a2f10 !important; }" +
    "@media screen and (max-width: 600px) {" +
    ".email-container { width: 100% !important; }" +
    ".stack { display: block !important; width: 100% !important; }" +
    ".px-mobile { padding-left: 20px !important; padding-right: 20px !important; }" +
    ".hide-mobile { display: none !important; }" +
    "}" +
    "@media (prefers-color-scheme: dark) {" +
    ".dark-bg { background-color: #121716 !important; }" +
    ".dark-card { background-color: #1a2120 !important; border-color: #2b3635 !important; }" +
    ".dark-text { color: #f2ece0 !important; }" +
    "}" +
    "</style>";

  function buildEventSection(s) {
    if (!s.events.length) return "";
    return s.events.map(function (ev, i) {
      var bottomPad = i === s.events.length - 1 ? 24 : 20;
      return (
        '<tr><td class="px-mobile dark-bg" style="background-color:#fffaf0; padding:0 40px ' + bottomPad + 'px 40px;">' +
        '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="dark-card" style="background-color:#ffffff; border:1px solid #e9e0c8; border-radius:8px;">' +
        '<tr><td style="padding:24px;">' +
        '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">' +
        '<tr><td><span style="display:inline-block; font-family:\'Nunito\',Verdana,Arial,sans-serif; font-weight:800; font-size:11px; letter-spacing:1px; text-transform:uppercase; color:#7d5f14; background-color:#edd286; border-radius:999px; padding:4px 12px;">Upcoming Event</span></td></tr>' +
        '<tr><td class="heading dark-text" style="font-size:18px; padding-top:14px; padding-bottom:8px; text-transform:none; letter-spacing:normal;">' + escapeHtml(ev.name) + '</td></tr>' +
        '<tr><td class="body-text dark-text" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; font-size:14px; line-height:1.6; color:#3a2f10; padding-bottom:16px;">' +
        escapeHtml(ev.date) + '<br>' + escapeHtml(ev.description) + '</td></tr>' +
        '<tr><td><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>' +
        '<td style="background-color:#edd286; border-radius:6px;">' +
        '<a href="' + escapeHtml(ev.link) + '" class="btn-link" target="_blank" style="display:inline-block; font-family:\'Nunito\',Verdana,Arial,sans-serif; font-weight:800; font-size:13px; letter-spacing:0.5px; text-transform:uppercase; color:#3a2f10; padding:12px 24px; text-decoration:none;">Event Details</a>' +
        '</td></tr></table></td></tr>' +
        '</table></td></tr></table></td></tr>'
      );
    }).join("");
  }

  function buildNewsSection(s) {
    if (!s.newsItems.length) return "";
    var rows = '<tr><td class="px-mobile dark-bg" style="background-color:#fffaf0; padding:0 40px 8px 40px;">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">' +
      '<tr><td class="heading dark-text" style="font-size:15px; padding-bottom:16px;">Neighborhood News</td></tr>' +
      '</table></td></tr>';
    s.newsItems.forEach(function (item, i) {
      var bottomPad = i === s.newsItems.length - 1 ? 28 : 20;
      rows += '<tr><td class="px-mobile dark-bg" style="background-color:#fffaf0; padding:0 40px ' + bottomPad + 'px 40px;">' +
        '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>' +
        '<td width="96" valign="top" class="stack" style="padding-right:16px;">' +
        '<img src="' + escapeHtml(item.imageUrl) + '" width="96" height="96" alt="" style="display:block; width:96px; height:96px; border-radius:6px; object-fit:cover;">' +
        '</td>' +
        '<td valign="top" class="stack body-text dark-text" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; color:#3a2f10;">' +
        '<div class="heading dark-text" style="font-size:15px; text-transform:none; letter-spacing:normal; padding-bottom:4px;">' + escapeHtml(item.headline) + '</div>' +
        '<div style="font-size:14px; line-height:1.6; padding-bottom:8px;">' + escapeHtml(item.summary) + '</div>' +
        '<a href="' + escapeHtml(item.link) + '" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; font-size:13px; font-weight:700; color:#4c8783; text-decoration:underline;">Read more →</a>' +
        '</td></tr></table></td></tr>';
    });
    return rows;
  }

  function buildHtml(s) {
    return (
      '<!doctype html>\n' +
      '<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">\n' +
      '<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n' +
      '<meta http-equiv="X-UA-Compatible" content="IE=edge">\n<meta name="color-scheme" content="light">\n' +
      '<meta name="supported-color-schemes" content="light">\n<title>' + escapeHtml(s.title) + '</title>\n' +
      '<!--[if mso]>\n<noscript>\n  <xml>\n    <o:OfficeDocumentSettings>\n      <o:PixelsPerInch>96</o:PixelsPerInch>\n    </o:OfficeDocumentSettings>\n  </xml>\n</noscript>\n' +
      '<style>\n  table, td { border-collapse: collapse; }\n  * { font-family: Arial, sans-serif !important; }\n</style>\n<![endif]-->\n' +
      EMAIL_HEAD_STYLE + '\n</head>\n' +
      '<body style="margin:0; padding:0; background-color:#fffaf0;" class="dark-bg">\n' +
      '  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#fffaf0; opacity:0;">' +
      escapeHtml(s.preheader) + ' &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>\n' +
      '  <center style="width:100%; background-color:#fffaf0;" class="dark-bg">\n' +
      '  <!--[if mso]>\n  <table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td>\n  <![endif]-->\n' +
      '  <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" border="0" align="center" style="width:600px; max-width:600px; margin:0 auto;">\n' +
      '    <tr><td style="background-color:#3f7a76; padding:22px 24px;" align="center">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>' +
      '<td align="center" style="font-family:\'Grandstander\',\'Trebuchet MS\',Verdana,sans-serif; font-weight:800; font-size:18px; letter-spacing:1px; text-transform:uppercase; color:#ffffff;">🏡&nbsp; Villa Park Friends and Neighbors</td>' +
      '</tr></table></td></tr>\n' +
      '    <tr><td style="background-color:#fffaf0;" class="dark-bg">' +
      '<img src="' + escapeHtml(s.heroImageUrl) + '" width="600" alt="' + escapeHtml(s.heroImageAlt) + '" style="display:block; width:100%; max-width:600px; height:auto;"></td></tr>\n' +
      '    <tr><td class="px-mobile dark-bg" style="background-color:#fffaf0; padding:32px 40px 8px 40px;">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">' +
      '<tr><td class="heading" style="font-size:26px; line-height:1.25; padding-bottom:12px;">' + escapeHtml(s.title) + '</td></tr>' +
      '<tr><td class="body-text dark-text" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; font-size:15px; line-height:1.6; color:#3a2f10;">' + escapeHtml(s.intro) + '</td></tr>' +
      '</table></td></tr>\n' +
      '    <tr><td class="dark-bg" style="background-color:#fffaf0; padding:20px 40px;">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="border-top:2px dashed #e9e0c8; font-size:1px; line-height:1px;">&nbsp;</td></tr></table></td></tr>\n' +
      buildEventSection(s) + '\n' +
      buildNewsSection(s) + '\n' +
      '    <tr><td class="dark-bg" style="background-color:#fffaf0; padding:0 40px 20px 40px;">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="border-top:2px dashed #e9e0c8; font-size:1px; line-height:1px;">&nbsp;</td></tr></table></td></tr>\n' +
      '    <tr><td class="px-mobile dark-bg" style="background-color:#fffaf0; padding:0 40px 32px 40px;">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#24504c; border-radius:8px;"><tr><td align="center" style="padding:32px 24px;">' +
      '<div class="heading" style="color:#ffffff; font-size:18px; padding-bottom:8px;">' + escapeHtml(s.ctaHeading) + '</div>' +
      '<div style="font-family:\'Nunito\',Verdana,Arial,sans-serif; color:#f2ece0; font-size:14px; line-height:1.6; padding-bottom:18px; max-width:400px; margin:0 auto;">' + escapeHtml(s.ctaBody) + '</div>' +
      '<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background-color:#edd286; border-radius:6px;">' +
      '<a href="' + escapeHtml(s.ctaLink) + '" class="btn-link" target="_blank" style="display:inline-block; font-family:\'Nunito\',Verdana,Arial,sans-serif; font-weight:800; font-size:13px; letter-spacing:0.5px; text-transform:uppercase; color:#3a2f10; padding:13px 28px; text-decoration:none;">' + escapeHtml(s.ctaButtonText) + '</a>' +
      '</td></tr></table></td></tr></table></td></tr>\n' +
      '    <tr><td style="background-color:#3f7a76; padding:28px 40px;" align="center">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">' +
      '<tr><td align="center" style="font-family:\'Grandstander\',\'Trebuchet MS\',Verdana,sans-serif; font-weight:800; font-size:13px; letter-spacing:1px; text-transform:uppercase; color:#ffffff; padding-bottom:10px;">🏡 Villa Park Friends and Neighbors</td></tr>' +
      '<tr><td align="center" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; font-size:12px; line-height:1.6; color:#c9e3e1; padding-bottom:14px;">' + escapeHtml(s.footerTagline) + '</td></tr>' +
      '<tr><td align="center" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; font-size:12px; color:#c9e3e1; padding-bottom:10px;"><a href="' + escapeHtml(s.siteUrl) + '" style="color:#edd286; text-decoration:underline;">' + escapeHtml(s.siteDisplay) + '</a></td></tr>' +
      '<tr><td align="center" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; font-size:11px; color:#a9d4d1; padding-bottom:6px;">{$company_name}<br>{$company_full_address}</td></tr>' +
      '<tr><td align="center" style="font-family:\'Nunito\',Verdana,Arial,sans-serif; font-size:11px; color:#a9d4d1;"><a href="{$unsubscribe}" style="color:#a9d4d1; text-decoration:underline;">Unsubscribe</a>&nbsp;·&nbsp;<a href="{$url}" style="color:#a9d4d1; text-decoration:underline;">View in browser</a></td></tr>' +
      '</table></td></tr>\n' +
      '  </table>\n  <!--[if mso]>\n  </td></tr></table>\n  <![endif]-->\n  </center>\n</body>\n</html>\n'
    );
  }

  function buildPlainText(s) {
    var lines = [];
    lines.push(s.title.toUpperCase());
    lines.push("");
    lines.push(s.intro);
    lines.push("");
    if (s.events.length) {
      lines.push("----------------------------------------");
      lines.push(s.events.length > 1 ? "UPCOMING EVENTS" : "UPCOMING EVENT");
      lines.push("");
      s.events.forEach(function (ev) {
        lines.push(ev.name);
        lines.push(ev.date);
        lines.push("");
        lines.push(ev.description);
        lines.push("Details: " + ev.link);
        lines.push("");
      });
      lines.push("----------------------------------------");
      lines.push("");
    }
    if (s.newsItems.length) {
      lines.push("NEIGHBORHOOD NEWS");
      lines.push("");
      s.newsItems.forEach(function (item) {
        lines.push(item.headline);
        lines.push(item.summary);
        lines.push("Read more: " + item.link);
        lines.push("");
      });
    }
    lines.push("----------------------------------------");
    lines.push(s.ctaHeading.toUpperCase());
    lines.push(s.ctaBody);
    lines.push(s.ctaLink);
    lines.push("----------------------------------------");
    lines.push("");
    lines.push(s.footerTagline);
    lines.push(s.siteDisplay + " — " + s.siteUrl);
    lines.push("");
    lines.push("{$company_name}");
    lines.push("{$company_full_address}");
    lines.push("");
    lines.push("Unsubscribe: {$unsubscribe}");
    lines.push("View this email in your browser: {$url}");
    return lines.join("\n");
  }

  var renderTimer = null;
  function onChange() {
    saveState();
    document.getElementById("saveSlug").value = document.getElementById("saveSlug").dataset.userEdited
      ? document.getElementById("saveSlug").value
      : defaultSlug(state.title);
    clearTimeout(renderTimer);
    renderTimer = setTimeout(renderPreview, 120);
  }

  function renderPreview() {
    document.getElementById("previewFrame").srcdoc = buildHtml(state);
  }

  function showToast(msg) {
    var t = document.getElementById("toast");
    t.textContent = msg;
    t.classList.add("show");
    clearTimeout(showToast._t);
    showToast._t = setTimeout(function () { t.classList.remove("show"); }, 2400);
  }

  function copyText(text) {
    var ok = false;
    try {
      var ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      ok = document.execCommand("copy");
      document.body.removeChild(ta);
    } catch (e) { ok = false; }
    if (ok) return Promise.resolve();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(text);
    }
    return Promise.reject(new Error("copy unsupported"));
  }

  function download(filename, text) {
    var blob = new Blob([text], { type: "text/plain;charset=utf-8" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }

  document.getElementById("copyHtmlBtn").addEventListener("click", function () {
    copyText(buildHtml(state)).then(function () {
      showToast("HTML copied — paste into MailerLite's Custom HTML editor");
    }, function () {
      showToast("Couldn't copy automatically — use Download instead");
    });
  });

  document.getElementById("copyTextBtn").addEventListener("click", function () {
    copyText(buildPlainText(state)).then(function () {
      showToast("Plain text copied — paste into MailerLite's Plain text tab");
    }, function () {
      showToast("Couldn't copy automatically — use Download instead");
    });
  });

  document.getElementById("downloadHtmlBtn").addEventListener("click", function () {
    download("newsletter.html", buildHtml(state));
  });

  document.getElementById("downloadTextBtn").addEventListener("click", function () {
    download("newsletter.txt", buildPlainText(state));
  });

  document.getElementById("addNewsItem").addEventListener("click", function () {
    state.newsItems.push({ imageUrl: "", headline: "", summary: "", link: "" });
    renderNewsItems();
    onChange();
  });

  document.getElementById("addCustomEvent").addEventListener("click", function () {
    state.events.push({ calendarId: null, name: "", date: "", description: "", link: "" });
    renderEventCards();
    onChange();
  });

  document.getElementById("resetBtn").addEventListener("click", function () {
    if (!confirm("Reset all fields to the example content? This can't be undone.")) return;
    state = JSON.parse(JSON.stringify(defaultState));
    saveState();
    populateSimpleFields();
    renderNewsItems();
    renderEventCards();
    renderCalendarChecklist();
    renderPreview();
  });

  document.getElementById("saveSlug").addEventListener("input", function (el) {
    el.target.dataset.userEdited = "1";
  });

  document.getElementById("saveDraftBtn").addEventListener("click", function () {
    var datestamp = new Date().toISOString().slice(0, 10);
    download("newsletter-draft-" + datestamp + ".json", JSON.stringify(state, null, 2));
    showToast("Draft saved — send this file to resume later or hand it off");
  });

  document.getElementById("loadDraftBtn").addEventListener("click", function () {
    document.getElementById("loadDraftInput").click();
  });

  document.getElementById("loadDraftInput").addEventListener("change", function (e) {
    var file = e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function () {
      var parsed;
      try {
        parsed = JSON.parse(reader.result);
      } catch (err) {
        alert("That doesn't look like a valid draft file.");
        return;
      }
      state = mergeWithDefaults(parsed);
      saveState();
      populateSimpleFields();
      renderNewsItems();
      renderEventCards();
      renderCalendarChecklist();
      renderPreview();
      showToast("Draft loaded");
    };
    reader.readAsText(file);
    e.target.value = "";
  });

  document.getElementById("saveRepoBtn").addEventListener("click", function () {
    var slug = document.getElementById("saveSlug").value.trim();
    if (!/^[a-z0-9-]+$/.test(slug)) {
      alert("File name can only contain lowercase letters, numbers, and hyphens.");
      return;
    }
    var btn = this;
    btn.disabled = true;
    var originalLabel = btn.textContent;
    btn.textContent = "Saving…";
    fetch("/api/newsletter/save", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        slug: slug,
        state: state,
        html: buildHtml(state),
        plainText: buildPlainText(state)
      })
    }).then(function (res) {
      return res.json().then(function (data) { return { ok: res.ok, data: data }; });
    }).then(function (result) {
      btn.disabled = false;
      btn.textContent = originalLabel;
      if (result.ok) {
        showToast("Saved to the repo as " + slug);
      } else {
        alert("Couldn't save: " + (result.data && result.data.error ? result.data.error : "unknown error"));
      }
    }).catch(function (err) {
      btn.disabled = false;
      btn.textContent = originalLabel;
      alert("Couldn't save: " + err.message);
    });
  });

  // ---- Netlify Identity gating ----
  // This client-side gate is a convenience, not the real security boundary — it
  // only controls what this page renders. The actual write to the repo is only
  // ever authorized server-side, in /api/newsletter/save, which independently
  // verifies the session with Netlify's identity service on every request.

  function refreshAuthUI() {
    var user = window.netlifyIdentity && window.netlifyIdentity.currentUser();
    var authGate = document.getElementById("authGate");
    var builderContent = document.getElementById("builderContent");
    var gateStatus = document.getElementById("gateStatus");
    var gateLoginBtn = document.getElementById("gateLoginBtn");
    var saveBtn = document.getElementById("saveRepoBtn");
    var authNote = document.getElementById("authNote");

    if (user) {
      authGate.hidden = true;
      builderContent.hidden = false;
      saveBtn.disabled = false;
      authNote.textContent = "Logged in as " + (user.email || "admin") + ".";
    } else {
      authGate.hidden = false;
      builderContent.hidden = true;
      gateStatus.textContent = "Log in with your site admin account to use this tool.";
      gateLoginBtn.hidden = false;
    }
  }

  document.getElementById("gateLoginBtn").addEventListener("click", function () {
    if (window.netlifyIdentity) window.netlifyIdentity.open("login");
  });

  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", refreshAuthUI);
    window.netlifyIdentity.on("login", refreshAuthUI);
    window.netlifyIdentity.on("logout", refreshAuthUI);
  } else {
    document.getElementById("gateStatus").textContent = "Couldn't load the login widget — try refreshing the page.";
  }

  populateSimpleFields();
  bindSimpleFields();
  renderNewsItems();
  renderEventCards();
  renderCalendarChecklist();
  renderPreview();
})();
</script>

</body>
</html>
