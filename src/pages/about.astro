---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { optimizedImage } from '../lib/image';

const page = await getEntry('pages', 'about');
const { Content } = await render(page!);

const circles = (await getCollection('circles')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="About">
  <h1>{page!.data.title}</h1>
  <div class="about-content">
    <Content />
  </div>

  <ul class="flex flex-wrap gap-3 list-none pl-0 mt-6 mb-4">
    {circles.map((circle) => (
      <li class="mb-0 odd:-rotate-1 even:rotate-1">
        <a
          href={`/circles/${circle.id}`}
          class="block font-heading bg-cream text-teal-deep font-bold text-sm uppercase tracking-wide border-2 border-teal-deep rounded px-4 py-1.5 text-center no-underline transition-colors hover:bg-gold hover:border-gold"
        >
          {circle.data.title}
        </a>
      </li>
    ))}
  </ul>

  <p>
    Have an idea for a new circle, or want to get involved in one of these? Reach out on the{' '}
    <a href="/contact">Contact</a> page.
  </p>

  {photos.length > 0 && (
    <>
      <h2>Around the Neighborhood</h2>
      <ul class="flex flex-wrap justify-center gap-4 list-none pl-0 mb-4">
        {photos.map((photo) => (
          <li class="mb-0">
            <img
              src={optimizedImage(photo.data.image, 300)}
              alt={photo.data.alt}
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover border-4 border-teal-deep"
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .about-content :global(p:first-of-type) {
    @apply text-xl font-heading text-gold-ink;
  }
</style>
