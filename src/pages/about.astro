---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'about');
const { Content } = await render(page!);

const circles = (await getCollection('circles')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout title="About">
  <h1>{page!.data.title}</h1>
  <div class="about-content">
    <Content />
  </div>

  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 list-none pl-0 mt-6 mb-4">
    {circles.map((circle) => (
      <li class="mb-0">
        <a
          href={`/circles/${circle.id}`}
          class="block bg-teal/10 text-teal-dark font-semibold text-sm rounded-full px-4 py-1.5 text-center no-underline transition-colors hover:bg-teal/20"
        >
          {circle.data.title}
        </a>
      </li>
    ))}
  </ul>

  <p>
    Have an idea for a new circle, or want to get involved in one of these? Reach out on the{' '}
    <a href="/contact">Contact</a> page.
  </p>
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .about-content :global(p:first-of-type) {
    @apply text-xl font-heading text-gold-ink;
  }
</style>
