---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import DiscordInvite from '../components/DiscordInvite.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">
  <h1>Villa Park Friends and Neighbors</h1>
  <p class="text-xl font-heading text-gold-dark">
    Building community, taking action, and celebrating the Villa Park neighborhood.
  </p>
  <p>News, updates, and resources for our neighborhood — maintained by volunteers.</p>

  <h2>Latest Updates</h2>
  {posts.length === 0 && <p>No posts yet — check back soon.</p>}
  <ul class="list-none p-0 space-y-5">
    {posts.map((post) => (
      <li class="card">
        {post.data.image && (
          <img
            src={post.data.image}
            alt=""
            class="w-full h-48 object-cover rounded-xl mb-4"
            loading="lazy"
          />
        )}
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
        <div class="text-neutral-500 text-sm">{post.data.date.toLocaleDateString()}</div>
        {post.data.summary && <p class="mb-0 mt-2">{post.data.summary}</p>}
      </li>
    ))}
  </ul>
  <p>
    <a href="/blog" class="btn">See all posts &rarr;</a>
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-8">
    <NewsletterSignup />
    <DiscordInvite />
  </div>
</BaseLayout>
