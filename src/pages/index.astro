---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import DiscordInvite from '../components/DiscordInvite.astro';
import FacebookGroupInvite from '../components/FacebookGroupInvite.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { optimizedImage } from '../lib/image';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const galleryEntry = await getEntry('gallery', 'photos');
const photos = galleryEntry?.data.photos ?? [];
---

<BaseLayout title="Villa Park Friends and Neighbors | Denver Neighborhood Association" fullTitle>
  <div class="relative left-1/2 -translate-x-1/2 -mt-8 w-screen bg-teal-deep">
    <div
      class="absolute inset-0 opacity-40 bg-[radial-gradient(rgba(255,255,255,0.16)_1.4px,transparent_1.4px)] bg-[length:13px_13px]"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-2xl mx-auto px-6 py-14 text-center">
      <span class="badge mb-5">Neighbors welcome</span>
      <h1 class="text-white text-4xl sm:text-5xl mb-3">Villa Park<br />Friends and Neighbors</h1>
      <p class="text-white/70 text-sm sm:text-base uppercase tracking-widest mb-3">
        Denver, Colorado
      </p>
      <p class="font-heading uppercase tracking-wide text-gold text-lg sm:text-xl mb-2">
        Building community, taking action, and celebrating the Villa Park neighborhood.
      </p>
      <p class="text-white/80 mb-0">
        We are a registered neighborhood organization (RNO) representing the Villa Park
        neighborhood in Denver, Colorado — volunteer-run news, updates, and resources.
      </p>
    </div>
  </div>

  <h2 class="mt-10 mb-2">Latest Updates</h2>
  <p class="mb-4">
    <a
      href="#newsletter"
      class="inline-flex items-center gap-1.5 font-body font-extrabold text-xs uppercase tracking-wide text-teal-dark decoration-gold-dark hover:text-gold-dark"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="M3 7l9 6 9-6"></path>
      </svg>
      Get the Neighborhood Newsletter &rarr;
    </a>
  </p>
  {posts.length === 0 && <p>No posts yet — check back soon.</p>}
  <ul class="list-none p-0 space-y-6">
    {posts.map((post) => (
      <li class="notice odd:-rotate-1 even:rotate-1">
        {post.data.image && (
          <img
            src={optimizedImage(post.data.image, 800)}
            alt={post.data.imageAlt || post.data.title}
            class="w-full h-48 object-cover rounded mb-4"
            loading="lazy"
          />
        )}
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
        <div class="text-neutral-500 dark:text-neutral-400 text-xs font-mono uppercase tracking-wide mt-1">
          {post.data.date.toLocaleDateString()}
        </div>
        {post.data.summary && <p class="mb-0 mt-2">{post.data.summary}</p>}
      </li>
    ))}
  </ul>
  <p>
    <a href="/blog" class="btn">See all posts &rarr;</a>
  </p>

  <div class="flex flex-col gap-5 mt-8">
    <NewsletterSignup id="newsletter" />
    <DiscordInvite />
    <FacebookGroupInvite />
  </div>

  <PhotoGallery photos={photos} heading="" />
</BaseLayout>
