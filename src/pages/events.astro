---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Events">
  <h1>Events</h1>
  <p>Upcoming neighborhood events, meetups, and circle gatherings.</p>

  <div class="card">
    <h3 class="mb-1">Calendar Coming Soon</h3>
    <p class="mb-0">
      We're setting up a shared calendar so you can see what's happening and add events to your
      own. Check back soon!
    </p>
  </div>
</BaseLayout>
