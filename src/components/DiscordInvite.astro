---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const DISCORD_INVITE_URL = 'https://discord.gg/JW7FNNqkQ';
---

<div class={`card ${className}`}>
  <h3 class="mb-1">Join us on Discord!</h3>
  <p class="mb-3">
    This is the best way to stay in touch about group events, join a circle, and make our
    neighborhood better.
  </p>
  <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer" class="btn">
    Join the Discord &rarr;
  </a>
</div>
