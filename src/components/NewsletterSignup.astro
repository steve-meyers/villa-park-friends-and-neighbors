---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`card ${className}`}>
  <h3 class="mb-1">Get Neighborhood Updates</h3>
  <p class="mb-3">
    Subscribe to get new posts and neighborhood news in your inbox. No spam, unsubscribe any time.
  </p>
  <!-- Placeholder only — not wired up to a real mailing list yet. -->
  <form class="flex flex-col sm:flex-row gap-2">
    <input
      type="email"
      placeholder="you@example.com"
      required
      class="input flex-1 disabled:opacity-60 disabled:cursor-not-allowed"
      disabled
      aria-label="Email address"
    />
    <button type="submit" class="btn disabled:opacity-60 disabled:cursor-not-allowed" disabled>
      Subscribe
    </button>
  </form>
  <p class="text-xs text-neutral-500 mt-2 mb-0">Signups are coming soon!</p>
</div>
