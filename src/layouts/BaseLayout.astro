---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const circles = (await getCollection('circles')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Villa Park Friends and Neighbors</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="flex flex-wrap items-center justify-between gap-4 px-6 py-4 bg-teal">
      <a href="/" class="font-heading font-bold text-lg text-white no-underline hover:text-white"
        >🏡 Villa Park Friends and Neighbors</a
      >
      <nav class="flex flex-wrap items-center gap-5">
        <a href="/" class="text-white font-semibold no-underline hover:text-gold">Home</a>
        <a href="/blog" class="text-white font-semibold no-underline hover:text-gold">Blog</a>
        <details class="relative">
          <summary
            class="text-white font-semibold no-underline hover:text-gold cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden"
          >
            Circles ▾
          </summary>
          <div class="absolute left-0 mt-2 min-w-56 bg-white rounded-xl shadow-lg py-2 z-20">
            {circles.map((circle) => (
              <a
                href={`/circles/${circle.id}`}
                class="block px-4 py-2 text-teal-dark font-medium no-underline hover:bg-teal/10"
              >
                {circle.data.title}
              </a>
            ))}
          </div>
        </details>
        <a href="/resources" class="text-white font-semibold no-underline hover:text-gold"
          >Resources</a
        >
        <a href="/about" class="text-white font-semibold no-underline hover:text-gold">About</a>
        <a href="/contact" class="text-white font-semibold no-underline hover:text-gold"
          >Contact</a
        >
      </nav>
    </header>

    <main class="flex-1 w-full max-w-2xl mx-auto px-6 pt-8 pb-16">
      <slot />
    </main>

    <footer class="text-center text-teal-dark text-sm py-6 bg-gold">
      <p>&copy; {new Date().getFullYear()} Villa Park Friends and Neighbors</p>
    </footer>
  </body>
</html>
